# Gitea 实例地址（根据实际地址填写，如局域网/Tailscale 域名）
GITEA_INSTANCE_URL=http://kongfu-onedrive.kooka-salmon.ts.net:23000

# Gitea Runner 注册 Token
# 获取路径：进入 Gitea 仓库或组织 -> 仓库设置 (Settings) -> CI/CD / Actions -> Runners -> 点击 "Create new Runner"
GITEA_RUNNER_REGISTRATION_TOKEN=your_registration_token_here

# Runner 名称
GITEA_RUNNER_NAME=realtime-chopper-runner
